# Configuration for the LLM service
# LLM_URL and LLM_NAME are now automatically set by Docker Compose model binding
# If you want to use an external LLM (like OpenAI), uncomment and set these:
# LLM_URL=https://api.openai.com/v1/chat/completions
# LLM_NAME=gpt-4o
# OPENAI_API_KEY=your_openai_api_key_here

# Port for the API to listen on
API_PORT=8000

# Port for the frontend to listen on
FRONTEND_PORT=8501
